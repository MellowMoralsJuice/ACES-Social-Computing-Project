# Copy this file to .env.local for local work against Supabase, and set the
# same variables in Vercel (Project > Settings > Environment Variables).
#
# With NO .env.local at all, `npm run dev` uses a built-in local database and
# 2-second polling, so you can try the app with zero setup.

# --- Database (server only) ---------------------------------------------------
# Supabase > Connect > "Transaction pooler" connection string (port 6543).
# Use the POOLED string: serverless functions must not hold direct connections.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-us-west-1.pooler.supabase.com:6543/postgres

# --- Supabase Realtime and Storage ----------------------------------------------
# Supabase > Project Settings > API.
# Server side: used by /api to announce "something changed" after a write, and to
# store recorded audio tips in a public Storage bucket named "breadcrumb-audio"
# (created on first upload: 1 MB file limit, audio types only). Without these two,
# recordings are kept in the database instead.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key   # SECRET. Never prefix with VITE_.

# Browser side (these two are public and are baked into the build by Vite):
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# --- Admin panel --------------------------------------------------------------------
# The shared team PIN for /admin and /admin/results. Required on Vercel.
# (Local dev without this variable uses 2468.)
ADMIN_PIN=change-me

# Optional: secret used to sign admin tokens. If unset it is derived from the PIN
# and the service key. Set it to any long random string to be explicit.
ADMIN_TOKEN_SECRET=
